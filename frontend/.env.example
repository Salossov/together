# URL бэкенда (без слэша в конце)
VITE_API_BASE=http://127.0.0.1:8080

# Имя/адрес игрового сервера для страницы Setup
VITE_SERVER_NAME=Together
VITE_SERVER_HOST=mc.example.com
VITE_SERVER_PORT=25565

# Microsoft OAuth настраивается ТОЛЬКО на бэкенде (MS_CLIENT_ID / MS_REDIRECT_URI).
# Фронт сам узнаёт authorize URL через GET /api/auth/microsoft/url.
# Если на бэке Microsoft не настроен — кнопка "Войти через Microsoft" не показывается.
