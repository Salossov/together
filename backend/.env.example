# Сервер
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,together_auth=debug

# JWT
JWT_SECRET=change-me-please-min-32-chars-long-secret-key
JWT_TTL_DAYS=30

# CORS (через запятую). "*" разрешает всё.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# База данных. Драйвер выбирается АВТОМАТИЧЕСКИ по схеме URL.
# Все три драйвера всегда вкомпилированы — пересборка при смене не нужна.
#
# Примеры:
#   sqlite://./data/together.db?mode=rwc
#   postgres://user:pass@localhost:5432/together
#   mysql://user:pass@localhost:3306/together
DATABASE_URL=sqlite://./data/together.db?mode=rwc

# (Опционально) Дополнительная БД для сохранности.
# Каждая запись (INSERT/UPDATE/DELETE) дублируется в эту базу.
# Тип может отличаться от основной — например, основная postgres, бэкап sqlite-снапшот.
# Ошибки записи в бэкап только логируются (warn) и не валят запрос.
# Закомментируйте/оставьте пустым, чтобы отключить.
# BACKUP_DATABASE_URL=sqlite://./data/together.backup.db?mode=rwc

# ─── Microsoft OAuth ──────────────────────────────────────────────────
#
# Чтобы вход через Microsoft работал, твой Azure App должен быть
# одобрен Mojang через https://aka.ms/mce-reviewappid (без этого
# api.minecraftservices.com будет возвращать 403, даже если у юзера
# есть Java Edition).
#
# Если поля пустые — кнопка "Войти через Microsoft" просто не
# показывается на сайте, всё работает на LOCAL-аккаунтах.
#
# Замечание: режим MS_LEGACY_LAUNCHER (использование launcher
# client_id с copy-paste URL) больше НЕ РАБОТАЕТ — Microsoft
# выпилил этот flow в 2026 (страница oauth20_desktop.srf теперь
# показывает "?removed=true" вместо кода). Оставлено в коде для
# истории, не используй.

MS_LEGACY_LAUNCHER=false
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# Mineskin (опционально, для подписи скина)
MINESKIN_API_KEY=

# Манифест клиента (для /launcher/version_check)
MANIFEST_PATH=./data/manifest.json
